{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/demo/?",
      "dest": "/demo.html"
    },
    {
      "src": "/polityka-prywatnosci/?",
      "dest": "/polityka-prywatnosci.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
